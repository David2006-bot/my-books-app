---
// src/pages/login.astro
const CLAVE_CORRECTA = "admin123"; // Cambia esta clave

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  const password = formData.get("password");

  if (password === CLAVE_CORRECTA) {
    // Guardamos la sesión en una cookie
    Astro.cookies.set("user_session", "active", { path: "/" });
    return Astro.redirect("/");
  }
}
---

<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Acceso al Sistema</title>
    <style>
        body { font-family: sans-serif; background: #f0f2f5; display: flex; justify-content: center; align-items: center; height: 100vh; margin: 0; }
        .login-card { background: white; padding: 2rem; border-radius: 12px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); width: 300px; }
        input, button { width: 100%; padding: 0.8rem; margin: 0.5rem 0; border-radius: 6px; border: 1px solid #ddd; box-sizing: border-box; }
        button { background: #0070f3; color: white; border: none; font-weight: bold; cursor: pointer; }
    </style>
</head>
<body>
    <div class="login-card">
        <h2 style="text-align: center;">Login</h2>
        <form method="POST">
            <input type="password" name="password" placeholder="Contraseña" required />
            <button type="submit">Entrar</button>
        </form>
    </div>
</body>
</html>