---
// src/pages/login.astro
const CLAVE_CORRECTA = "admin123"; // Cambia esta clave

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  const password = formData.get("password");

  if (password === CLAVE_CORRECTA) {
    // Guardamos la sesión en una cookie
    Astro.cookies.set("user_session", "active", { path: "/" });
    return Astro.redirect("/");
  }
}
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <title>Acceso al Sistema</title>
    <style>
      /* 1. Estilos base (PC y Tablet) */
      body {
        font-family:
          system-ui,
          -apple-system,
          sans-serif;
        background: #f0f2f5;
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
        margin: 0;
        padding: 0; /* Limpiamos padding por defecto */
      }
      .login-card {
        background: white;
        padding: 2.5rem; /* Padding base grande para PC */
        border-radius: 12px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        width: 100%;
        max-width: 380px; /* Ancho elegante para laptop */
        box-sizing: border-box; /* Crucial para que el padding no estire la card */
      }
      h2 {
        text-align: center;
        margin-top: 0;
        margin-bottom: 20px;
        font-size: 1.6rem;
        color: #1a1a1a;
      }
      input,
      button {
        width: 100%;
        padding: 1rem; /* Padding táctil cómodo */
        margin: 0.6rem 0;
        border-radius: 8px;
        border: 1px solid #ddd;
        box-sizing: border-box;
        font-size: 16px; /* 16px evita el zoom automático de iPhone al escribir */
      }
      button {
        background: #0070f3;
        color: white;
        border: none;
        font-weight: bold;
        cursor: pointer;
        transition: background 0.2s ease;
        font-size: 16px;
      }
      button:hover {
        background: #0056b3;
      }

      /* 2. MEDIA QUERY: AJUSTES ESPECÍFICOS PARA CELULAR (Ancho menor a 480px) */
      @media (max-width: 480px) {
        body {
          /* En móvil ya no centramos verticalmente con Flexbox, 
               sino que le damos un padding arriba */
          align-items: flex-start;
          padding-top: 40px;
        }
        .login-card {
          /* Esta es la magia: la card ahora ocupa el 90% del ancho móvil */
          width: 90%;
          padding: 2rem 1.5rem; /* Reducimos padding interno para ganar espacio */
          max-width: none; /* Quitamos el max-width que la hacía pequeña */
        }
        h2 {
          font-size: 1.4rem;
        }
        input,
        button {
          padding: 0.9rem;
        } /* Ligeramente más pequeños los inputs */
      }
    </style>
  </head>
  <body>
    <div class="login-card">
      <h2 style="text-align: center;">Login</h2>
      <form method="POST">
        <input
          type="password"
          name="password"
          placeholder="Contraseña"
          required
        />
        <button type="submit">Entrar</button>
      </form>
    </div>
  </body>
</html>
