---
//conexion para traer los datos
import { supabase } from "../lib/supabase";

// Si no hay cookie, mandamos al login
const session = Astro.cookies.get("user_session");
if (!session) {
  return Astro.redirect("/login");
}

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  const action = formData.get("action");

  if (action === "create") {
    await supabase.from("pedidos").insert([
      {
        cliente: formData.get("cliente"),
        producto: formData.get("producto"),
        cantidad: formData.get("cantidad"),
      },
    ]);
  }

  if (action === "delete") {
    await supabase.from("pedidos").delete().eq("id", formData.get("id"));
  }

  if (action === "update_status") {
    const id = formData.get("id");
    const nuevoEstado = formData.get("nuevoEstado");
    await supabase.from("pedidos").update({ estado: nuevoEstado }).eq("id", id);
  }
}

// 2. OBTENER DATOS ACTUALIZADOS
const { data: pedidos } = await supabase
  .from("pedidos")
  .select("*")
  .order("created_at", { ascending: false });
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <title>Sistema de Pedidos - David Saravia</title>
    <style>
      body {
        font-family: sans-serif;
        background: #f4f4f9;
        padding: 20px;
      }
      .container {
        max-width: 600px;
        margin: 0 auto;
      }
      .card {
        background: white;
        padding: 20px;
        border-radius: 8px;
        margin-bottom: 20px;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
      }
      input {
        width: 100%;
        padding: 10px;
        margin: 5px 0;
        border: 1px solid #ccc;
        border-radius: 4px;
        box-sizing: border-box;
      }
      button {
        background: #3e49c3;
        color: white;
        border: none;
        padding: 10px;
        width: 100%;
        border-radius: 4px;
        cursor: pointer;
      }
      .pedido-item {
        display: flex;
        justify-content: space-between;
        padding: 10px;
        border-bottom: 1px solid #eee;
        align-items: center;
      }
      .btn-del {
        background: #dc3545;
        padding: 5px 10px;
        font-size: 0.8rem;
      }
      .status-select {
        padding: 6px;
        border-radius: 4px;
        border: 1px solid #ccc;
        background-color: #fff;
        cursor: pointer;
        font-size: 0.9rem;
      }

      .status-select:focus {
        outline: none;
        border-color: #0070f3;
      }
      .btn-edit {
        background: #606afc;
        color: black;
        padding: 5px 10px;
        text-decoration: none;
        border-radius: 4px;
        font-size: 0.8rem;
        margin: 0 5px;
      }

      /* Borra las anteriores de status-xxx y pon estas: */
      .status-pendiente {
        background-color: #fff3cd !important;
      }
      .status-procesando {
        background-color: #cce5ff !important;
      }
      .status-entregado {
        background-color: #d4edda !important;
      }
      .status-cancelado {
        background-color: #f8d7da !important;
      }

      /* Mantén un color de fondo base para que no se vea vacío */
      .pedido-item {
        display: flex;
        justify-content: space-between;
        padding: 10px;
        border-bottom: 3px solid #eee;
        align-items: center;
        transition: background-color 0.3s ease; /* Transición suave al cambiar */
      }
    </style>
  </head>
  <body>
    <div class="container">
      <h1>Pedidos - David Saravia</h1>

      <div class="card">
        <h3>Nuevo Pedido</h3>
        <form method="POST">
          <input type="hidden" name="action" value="create" />
          <input
            type="text"
            name="cliente"
            placeholder="Nombre del Cliente"
            required
          />

          <input
            type="number"
            name="cantidad"
            placeholder="Cantidad del Producto"
            required
          />

          <input
            type="text"
            name="producto"
            placeholder="Nombre del Producto"
            required
          />
          <button type="submit">Guardar Pedido</button>
        </form>
      </div>

      <div class="card">
        <h3>Lista de Pedidos</h3>
        {
          pedidos?.map((pedido) => (
            <div class="pedido-item">
              <div class={`pedido-item status-${pedido.estado}`}>
                <strong>{pedido.cliente}</strong> ({pedido.cantidad})
                <br />
                <small>
                  {pedido.producto} -{" "}
                  {new Date(pedido.created_at).toLocaleDateString("es-ES", {
                    day: "2-digit",
                    month: "short",
                    year: "2-digit",
                  })}
                </small>
              </div>

              <a href={`/editar/${pedido.id}`} class="btn-edit">
                Editar
              </a>

              <form method="POST" onchange="this.submit()">
                <input type="hidden" name="action" value="update_status" />
                <input type="hidden" name="id" value={pedido.id} />

                <select name="nuevoEstado" class="status-select">
                  <option
                    value="pendiente"
                    selected={pedido.estado === "pendiente"}
                  >
                    Pendiente
                  </option>
                  <option
                    value="procesando"
                    selected={pedido.estado === "procesando"}
                  >
                    Procesando
                  </option>
                  <option
                    value="entregado"
                    selected={pedido.estado === "entregado"}
                  >
                    Entregado
                  </option>
                  <option
                    value="cancelado"
                    selected={pedido.estado === "cancelado"}
                  >
                    Cancelado
                  </option>
                </select>
              </form>

              <form method="POST">
                <input type="hidden" name="action" value="delete" />
                <input type="hidden" name="id" value={pedido.id} />
                <button type="submit" class="btn-del">
                  X
                </button>
              </form>
            </div>
          ))
        }
      </div>
    </div>
  </body>
</html>
